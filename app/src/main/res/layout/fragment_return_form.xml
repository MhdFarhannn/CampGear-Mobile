<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/content_gutter">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/return_title" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnSurface" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/return_info" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/textReturnLoan" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView android:id="@+id/textReturnBorrower" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView android:id="@+id/textReturnDue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilReturnDateActual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:hint="@string/label_return_date_actual" app:startIconDrawable="@drawable/ic_calendar">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputReturnDateActual" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:cursorVisible="false" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="@string/label_units" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerReturnUnits" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilReturnNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:hint="@string/return_note_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputReturnNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLines="4" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" app:cardBackgroundColor="?attr/colorSecondaryContainer" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/return_estimated_fine" android:textAppearance="@style/TextAppearance.CampGear.LabelLarge" android:textColor="?attr/colorOnSecondaryContainer" />
                        <TextView android:id="@+id/textFineValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnSecondaryContainer" />
                        <TextView android:id="@+id/textFineDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSecondaryContainer" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="@string/return_estimate_notice" android:textAppearance="@style/TextAppearance.CampGear.Label" android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/textSubmitError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorError" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.app.campgear.ui.common.StateLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginVertical="@dimen/space_2">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSubmitReturn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/return_submit" app:icon="@drawable/ic_returns" />
        <ProgressBar android:id="@+id/submitReturnProgress" android:layout_width="@dimen/icon_small" android:layout_height="@dimen/icon_small" android:layout_gravity="center" android:indeterminateTint="?attr/colorOnPrimary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
