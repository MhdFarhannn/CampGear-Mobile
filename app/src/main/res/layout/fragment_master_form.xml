<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="@dimen/space_3">
                <TextView android:id="@+id/formTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnSurface" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginTop="@dimen/space_1" android:text="@string/master_form_intro" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <include android:id="@+id/userFields" layout="@layout/dialog_user" />
                <include android:id="@+id/categoryFields" layout="@layout/dialog_kategori" />
                <include android:id="@+id/unitFields" layout="@layout/dialog_unit" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.app.campgear.ui.common.StateLayout>
    <TextView android:id="@+id/textMasterError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorError" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginVertical="@dimen/space_2">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveMaster" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_save" app:icon="@drawable/ic_check" />
        <ProgressBar android:id="@+id/masterProgress" android:layout_width="@dimen/icon_small" android:layout_height="@dimen/icon_small" android:layout_gravity="center" android:indeterminateTint="?attr/colorOnPrimary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
