<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/content_gutter">
                <TextView android:id="@+id/formAlatTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnSurface" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/equipment_form_intro" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" app:contentPadding="0dp">
                    <ImageView android:id="@+id/alatImagePreview" android:layout_width="match_parent" android:layout_height="@dimen/equipment_image_height" android:src="@drawable/illustration_gear" android:scaleType="centerCrop" android:contentDescription="@string/label_image" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/textAlatImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.Label" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonPickImage" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/action_pick_image" app:icon="@drawable/ic_add" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAlatName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:hint="@string/alat_name_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputAlatName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1" android:maxLength="150" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAlatCategory" style="@style/Widget.CampGear.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_category">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dropdownAlatKategori" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAlatPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_price_per_day" app:prefixText="@string/currency_prefix">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputAlatPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAlatDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/alat_description_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputAlatDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:maxLines="6" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/textAlatFormError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorError" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.app.campgear.ui.common.StateLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginVertical="@dimen/space_2">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveAlat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_save" app:icon="@drawable/ic_check" />
        <ProgressBar android:id="@+id/alatFormProgress" android:layout_width="@dimen/icon_small" android:layout_height="@dimen/icon_small" android:layout_gravity="center" android:indeterminateTint="?attr/colorOnPrimary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
