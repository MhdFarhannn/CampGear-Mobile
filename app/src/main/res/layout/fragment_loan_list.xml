<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginTop="@dimen/space_2" android:text="@string/loan_list_intro" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/list_gutter" android:layout_marginTop="@dimen/space_1" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:singleLine="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/filter_all" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDiajukan" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_diajukan" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDisetujui" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_disetujui" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDitolak" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_ditolak" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDipinjam" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_dipinjam" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSelesai" style="@style/Widget.CampGear.FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_selesai" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerLoans" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="@dimen/space_3" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <ProgressBar android:id="@+id/paginationProgress" android:layout_width="@dimen/icon_small" android:layout_height="@dimen/icon_small" android:layout_gravity="bottom|center_horizontal" android:layout_margin="@dimen/space_2" android:visibility="gone" />
    </com.app.campgear.ui.common.StateLayout>
</LinearLayout>
