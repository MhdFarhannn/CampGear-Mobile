<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/list_gutter" android:layout_marginTop="@dimen/space_2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/unitCode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonUnitMenu" style="@style/Widget.Material3.Button.TextButton" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:minWidth="0dp" android:padding="0dp" app:icon="@drawable/ic_more" android:contentDescription="@string/action_more" />
        </LinearLayout>
        <TextView android:id="@+id/unitAlatName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" app:singleLine="false">
            <TextView android:id="@+id/unitItemStatus" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_1" />
            <TextView android:id="@+id/unitAvailabilityStatus" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
