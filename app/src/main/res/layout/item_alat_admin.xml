<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/list_gutter" android:layout_marginTop="@dimen/space_2" app:contentPadding="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/adminAlatImage" android:layout_width="match_parent" android:layout_height="@dimen/equipment_image_height" android:scaleType="centerCrop" android:src="@drawable/illustration_gear" android:contentDescription="@string/label_image" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_2">
            <TextView android:id="@+id/adminAlatCategory" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnPrimaryContainer" android:backgroundTint="?attr/colorPrimaryContainer" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="@dimen/space_1">
                <TextView android:id="@+id/adminAlatName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAlatMenu" style="@style/Widget.Material3.Button.TextButton" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:minWidth="0dp" android:padding="0dp" app:icon="@drawable/ic_more" android:contentDescription="@string/action_more" />
            </LinearLayout>
            <TextView android:id="@+id/adminAlatPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorPrimary" />
            <TextView android:id="@+id/adminAlatStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
