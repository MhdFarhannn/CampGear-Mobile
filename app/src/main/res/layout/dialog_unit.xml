<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/content_gutter" android:paddingVertical="@dimen/space_3">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUnitCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/label_unit_code">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputUnitCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/units_code_hint" android:inputType="textCapCharacters" android:maxLines="1" android:maxLength="50" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUnitStatus" style="@style/Widget.CampGear.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_item_status">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dropdownUnitStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUnitAvailability" style="@style/Widget.CampGear.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_availability">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dropdownUnitAvailability" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="@string/unit_form_notice" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
