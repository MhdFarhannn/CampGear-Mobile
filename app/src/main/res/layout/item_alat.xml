<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/list_gutter" android:layout_marginTop="@dimen/space_2" android:clickable="true" android:focusable="true" app:contentPadding="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/alatImage" android:layout_width="match_parent" android:layout_height="@dimen/equipment_image_height"
            android:scaleType="centerCrop" android:src="@drawable/illustration_gear" android:contentDescription="@string/label_image" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_2">
            <TextView android:id="@+id/alatCategory" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnPrimaryContainer" android:backgroundTint="?attr/colorPrimaryContainer" />
            <TextView android:id="@+id/alatName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/alatDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1"
                android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/alatStock" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/alatPrice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAdd" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/catalog_add" app:icon="@drawable/ic_add" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
