<?xml version="1.0" encoding="utf-8"?>
<com.app.campgear.ui.common.StateLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/content_gutter">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <ImageView android:layout_width="@dimen/icon_medium" android:layout_height="@dimen/icon_medium" android:src="@drawable/ic_check" android:contentDescription="@string/return_success" app:tint="?attr/colorOnPrimaryContainer" />
                    <TextView android:id="@+id/detailReturnNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnPrimaryContainer" />
                    <TextView android:id="@+id/detailReturnBorrower" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnPrimaryContainer" />
                    <TextView android:id="@+id/detailReturnDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/fine_breakdown_title" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/detailReturnLate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.Body" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/detailLateFine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.Body" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/detailConditionFine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.Body" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/detailReturnFine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorPrimary" />
            <TextView android:id="@+id/detailReturnNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/dialog_return_detail_units" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerReturnUnits" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.app.campgear.ui.common.StateLayout>
