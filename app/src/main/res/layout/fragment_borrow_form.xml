<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/content_gutter">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/borrow_title" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorOnSurface" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/borrow_estimate_hint" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="@string/borrow_items_heading" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerCart" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="@string/borrow_dates_heading" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilLoanDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_loan_date" app:startIconDrawable="@drawable/ic_calendar">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputLoanDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:cursorVisible="false" android:focusable="true" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilReturnDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="@string/label_return_date" app:startIconDrawable="@drawable/ic_calendar">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputReturnDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:cursorVisible="false" android:focusable="true" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/textDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.LabelLarge" android:textColor="?attr/colorPrimary" />
                <TextView android:id="@+id/textFormError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.app.campgear.ui.common.StateLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/content_gutter" android:paddingVertical="@dimen/space_2" android:background="?attr/colorSurface">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_estimated_total" android:textAppearance="@style/TextAppearance.CampGear.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/textEstimatedTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorPrimary" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/borrow_submit" app:icon="@drawable/ic_check" />
            <ProgressBar android:id="@+id/submitProgress" android:layout_width="@dimen/icon_small" android:layout_height="@dimen/icon_small" android:layout_gravity="center" android:indeterminateTint="?attr/colorOnPrimary" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
