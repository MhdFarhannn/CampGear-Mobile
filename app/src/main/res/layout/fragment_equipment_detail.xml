<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.app.campgear.ui.common.StateLayout android:id="@+id/stateLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/content_gutter">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CampGear.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:contentPadding="0dp">
                    <ImageView android:id="@+id/equipmentImage" android:layout_width="match_parent" android:layout_height="@dimen/detail_image_height" android:src="@drawable/illustration_gear" android:scaleType="centerCrop" android:contentDescription="@string/label_image" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/equipmentCategory" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:backgroundTint="?attr/colorPrimaryContainer" android:textColor="?attr/colorOnPrimaryContainer" />
                <TextView android:id="@+id/equipmentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.Headline" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/equipmentPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.CampGear.Title" android:textColor="?attr/colorPrimary" />
                <TextView android:id="@+id/equipmentStock" style="@style/Widget.CampGear.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/label_description" android:textAppearance="@style/TextAppearance.CampGear.TitleSmall" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/equipmentDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampGear.Body" android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.app.campgear.ui.common.StateLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/buttonBorrowEquipment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/content_gutter" android:layout_marginVertical="@dimen/space_2" android:text="@string/equipment_borrow" app:icon="@drawable/ic_cart" />
</LinearLayout>
