<resources>
    <style name="Theme.CampGear" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/background</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CampGear.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.CampGear.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CampGear.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CampGear.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CampGear.TitleSmall</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CampGear.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CampGear.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CampGear.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CampGear.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CampGear.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.CampGear.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CampGear.Label</item>
        <item name="textInputStyle">@style/Widget.CampGear.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.CampGear.Button</item>
        <item name="chipStyle">@style/Widget.CampGear.FilterChip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CampGear.Dialog</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CampGear.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CampGear.Card</item>
    </style>

    <style name="Theme.CampGear.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CampGear</item>
    </style>
    <style name="ThemeOverlay.CampGear.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />
    <style name="ShapeAppearance.CampGear.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_small</item>
    </style>
    <style name="ShapeAppearance.CampGear.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="TextAppearance.CampGear.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/type_headline</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.CampGear.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/type_title</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.CampGear.TitleSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/type_title_small</item>
    </style>
    <style name="TextAppearance.CampGear.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/type_body</item>
    </style>
    <style name="TextAppearance.CampGear.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/type_body_small</item>
    </style>
    <style name="TextAppearance.CampGear.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/type_label</item>
    </style>
    <style name="TextAppearance.CampGear.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/type_body_small</item>
    </style>

    <style name="Widget.CampGear.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.CampGear.Card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="contentPadding">@dimen/space_2</item>
    </style>
    <style name="Widget.CampGear.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_small</item>
    </style>
    <style name="Widget.CampGear.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_small</item>
    </style>
    <style name="Widget.CampGear.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="android:textAppearance">@style/TextAppearance.CampGear.LabelLarge</item>
    </style>
    <style name="Widget.CampGear.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">@style/TextAppearance.CampGear.LabelLarge</item>
    </style>
    <style name="Widget.CampGear.Status" parent="">
        <item name="android:textAppearance">@style/TextAppearance.CampGear.Label</item>
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:paddingLeft">@dimen/space_2</item>
        <item name="android:paddingRight">@dimen/space_2</item>
        <item name="android:paddingTop">@dimen/space_1</item>
        <item name="android:paddingBottom">@dimen/space_1</item>
    </style>
</resources>
